/**
 * 偏好设置的桌面能力层（主进程侧）。
 *
 * 职责边界（与渲染层的分工）：
 * - 渲染层 localStorage 是设置值的**唯一写入方**；本模块只镜像一份快照到
 *   `userData/desktop-settings.json`，目的是让代理与全局快捷键在 app ready 后
 *   立即生效，而不必等渲染层挂载再回灌。
 * - 「打开知识库主窗口 / 唤起小记」两项 globalShortcut 在本模块注册；
 *   「新建文档 / 全局搜索」属应用内快捷键（mousetrap 族），由渲染层消费。
 * - 开机自启的真值在操作系统（`app.getLoginItemSettings`），不经本地快照。
 */
import { app, globalShortcut, ipcMain, session, shell } from "electron"
import fs from "node:fs"
import path from "node:path"

/** 代理配置形状（与渲染层 constants/desktop-settings 的 ProxySettings 同构，
 *  主进程与渲染层构建目标不同，不做跨目录 import）。 */
export interface ProxySettings {
  enable: boolean
  /** `HTTP` 走 proxyRules，`PAC` 走 pacScript。 */
  mode: "HTTP" | "PAC"
  /** HTTP 模式下的代理协议，直接体现在 url 前缀里。 */
  type: "HTTP" | "SOCKS4" | "SOCKS5"
  url: string
}

/** 快照落盘的形状。 */
interface SettingsSnapshot {
  proxy?: ProxySettings
  trayVisible?: boolean
  /** 键为快捷键标识，值为 `CommandOrControl+Alt+Y` 形式的 accelerator，或哨兵 NO_SHORTCUT。 */
  globalShortcuts?: Record<string, string>
  /** 主窗口几何（语雀的 main_position + windowSize 两处在我们是同一件事）。 */
  windowBounds?: WindowBounds
}

export interface WindowBounds {
  x?: number
  y?: number
  width: number
  height: number
}

/** 「取消快捷键」的哨兵值（与渲染层 constants/desktop-settings 同一字面量）。 */
export const NO_SHORTCUT = "NO_SHORTCUT"

/** 本模块能注册的全局快捷键动作白名单（渲染层只能触发这些行为）。 */
const GLOBAL_SHORTCUT_ACTIONS = new Set(["openMainWindow", "openMiniWindow"])

/** accelerator 只接受「修饰键+主键」组合，挡住换行、注入等非法串。 */
const ACCELERATOR_PATTERN = /^[A-Za-z0-9]+(?:\+[A-Za-z0-9]+){1,4}$/
const HAS_MODIFIER_PATTERN = /(CommandOrControl|CmdOrCtrl|Command|Ctrl|Alt|Shift|Super)/

/** 代理地址字符集收紧到协议+主机+端口，避免把奇怪串交给 session。 */
const PROXY_URL_PATTERN = /^[a-z][a-z0-9+.-]*:\/\/[A-Za-z0-9._-]+(?::\d{1,5})?(?:\/\S*)?$/
const PAC_URL_PATTERN = /^(https?:)?\/\/[A-Za-z0-9._-]+(?::\d{1,5})?\/\S*$/

/**
 * 注入依赖：托盘显隐由 index.ts 负责（Electron 的 Tray 没有 setVisible，
 * 只能 destroy 后重建，属于窗口层生命周期，不该由本模块持有）；
 * 另两个是主窗口动作与渲染层广播。
 */
export interface DesktopSettingsDeps {
  setTrayVisible: (visible: boolean) => boolean
  focusMainWindow: () => void
  broadcastToRenderer: (channel: string, payload?: unknown) => void
}

let deps: DesktopSettingsDeps | null = null
let snapshot: SettingsSnapshot = {}
/** 当前已注册的全局快捷键：accelerator -> action（用于替换时先注销）。 */
const registered = new Map<string, string>()

const snapshotPath = () => path.join(app.getPath("userData"), "desktop-settings.json")

const readSnapshot = (): SettingsSnapshot => {
  try {
    const parsed = JSON.parse(fs.readFileSync(snapshotPath(), "utf-8")) as SettingsSnapshot
    return typeof parsed === "object" && parsed !== null ? parsed : {}
  } catch {
    return {}
  }
}

/**
 * 先写临时文件再 rename：主进程崩在中途也不会留下半截 JSON 让下次启动读不回代理配置。
 */
const writeSnapshot = () => {
  try {
    const target = snapshotPath()
    const tmp = `${target}.tmp`
    fs.mkdirSync(path.dirname(target), { recursive: true })
    fs.writeFileSync(tmp, JSON.stringify(snapshot, null, 2), "utf-8")
    fs.renameSync(tmp, target)
  } catch (error) {
    console.warn("[xiaoye] 偏好设置快照写入失败：", error)
  }
}

const isProxySettings = (value: unknown): value is ProxySettings => {
  if (typeof value !== "object" || value === null) {
    return false
  }
  const candidate = value as Record<string, unknown>
  return (
    typeof candidate.enable === "boolean" &&
    (candidate.mode === "HTTP" || candidate.mode === "PAC") &&
    typeof candidate.url === "string" &&
    candidate.url.length <= 512
  )
}

/**
 * 把代理设置落到默认 session；关闭或空地址时清空回直连。
 * Electron 的 Session 没有 clearProxy，清空即 `proxyRules: ""`。
 */
const applyProxy = async (settings: ProxySettings) => {
  const ses = session.defaultSession

  if (!settings.enable || !settings.url.trim()) {
    await ses.setProxy({ proxyRules: "" })
    return true
  }

  if (settings.mode === "PAC") {
    if (!PAC_URL_PATTERN.test(settings.url)) {
      return false
    }
    await ses.setProxy({ pacScript: settings.url, proxyRules: "" })
    return true
  }

  if (!PROXY_URL_PATTERN.test(settings.url)) {
    return false
  }

  await ses.setProxy({ proxyRules: settings.url })
  return true
}

/**
 * 注册（或替换）一个全局快捷键。返回 false 表示系统占用，调用方应保持原值。
 */
const applyGlobalShortcut = (action: string, accelerator: string | null) => {
  const previous = snapshot.globalShortcuts?.[action]

  if (previous && registered.get(previous) === action) {
    globalShortcut.unregister(previous)
    registered.delete(previous)
  }

  if (!accelerator || accelerator === NO_SHORTCUT) {
    snapshot.globalShortcuts = { ...snapshot.globalShortcuts, [action]: NO_SHORTCUT }
    writeSnapshot()
    return true
  }

  if (!ACCELERATOR_PATTERN.test(accelerator) || !HAS_MODIFIER_PATTERN.test(accelerator)) {
    return false
  }

  if (registered.has(accelerator)) {
    return false
  }

  if (!globalShortcut.register(accelerator, () => runGlobalShortcutAction(action))) {
    return false
  }

  registered.set(accelerator, action)
  snapshot.globalShortcuts = { ...snapshot.globalShortcuts, [action]: accelerator }
  writeSnapshot()
  return true
}

const runGlobalShortcutAction = (action: string) => {
  if (!deps) {
    return
  }

  if (action === "openMainWindow") {
    deps.focusMainWindow()
    return
  }

  if (action === "openMiniWindow") {
    // 小记是渲染层页面（/knowledge/notes）：主窗口唤起后由渲染层负责跳转与聚焦输入
    deps.focusMainWindow()
    deps.broadcastToRenderer("xiaoye:tray-command", "navigate-notes")
  }
}

/** 「在状态栏中显示图标」的用户意愿（默认开启）。 */
export const isTrayVisibleRequested = () => snapshot.trayVisible !== false

/**
 * 上次的主窗口几何。调用方（createWindow）负责再校验它能否装进当前屏幕，
 * 换显示器/分辨率变了就该弃用——与语雀 `mainWindowSize` 的判定同口径。
 */
export const getSavedWindowBounds = (): WindowBounds | null => {
  const saved = snapshot.windowBounds
  return saved && Number.isFinite(saved.width) && Number.isFinite(saved.height) ? saved : null
}

/** 写窗口几何：resize/move 会连发，先经 index.ts 的去抖再落到这里。 */
export const saveWindowBounds = (bounds: WindowBounds) => {
  snapshot.windowBounds = bounds
  writeSnapshot()
}

/**
 * 启动期回放快照：代理与全局快捷键不必等渲染层挂载。
 */
export const restoreDesktopSettings = () => {
  snapshot = readSnapshot()

  if (snapshot.proxy) {
    void applyProxy(snapshot.proxy).then(ok => {
      if (!ok) {
        console.warn("[xiaoye] 快照中的代理地址非法，已忽略")
      }
    })
  }

  for (const [action, accelerator] of Object.entries(snapshot.globalShortcuts ?? {})) {
    if (!GLOBAL_SHORTCUT_ACTIONS.has(action) || accelerator === NO_SHORTCUT) {
      continue
    }
    if (!applyGlobalShortcut(action, accelerator)) {
      console.warn(`[xiaoye] 全局快捷键 ${accelerator} 启动注册失败（可能已被其它应用占用）`)
    }
  }
}

/**
 * 注册偏好设置相关的 IPC 通道，并在 app ready 之后回放快照。
 */
export const registerDesktopSettingsIpc = (injected: DesktopSettingsDeps) => {
  deps = injected

  // 开机自启的真值只在操作系统侧（用户可能在系统设置里改），其余设置项渲染层
  // 读自己的 localStorage，故这里不镜像返回——避免长出第二个事实源。
  ipcMain.handle("xiaoye:get-open-at-login", () => app.getLoginItemSettings().openAtLogin)

  ipcMain.handle("xiaoye:set-open-at-login", (_event, enabled: unknown) => {
    if (typeof enabled !== "boolean") {
      return false
    }

    // Electron 44 的 LoginItemSettings 已无 openAsHidden（改由 extraLaunchItems 表达），
    // 这里只带 --hideWindow 参数让渲染层启动时不抢焦点
    app.setLoginItemSettings({
      openAtLogin: enabled,
      args: ["--hideWindow", "true"],
    })
    return app.getLoginItemSettings().openAtLogin === enabled
  })

  ipcMain.handle("xiaoye:set-proxy-settings", async (_event, value: unknown) => {
    if (!isProxySettings(value)) {
      return false
    }

    const settings: ProxySettings = {
      enable: value.enable,
      mode: value.mode,
      type: value.type === "SOCKS4" || value.type === "SOCKS5" ? value.type : "HTTP",
      url: value.url.trim(),
    }

    const ok = await applyProxy(settings)
    if (!ok) {
      return false
    }

    snapshot.proxy = settings
    writeSnapshot()
    return true
  })

  ipcMain.handle("xiaoye:set-tray-visible", (_event, visible: unknown) => {
    if (typeof visible !== "boolean") {
      return false
    }

    if (!injected.setTrayVisible(visible)) {
      return false
    }

    snapshot.trayVisible = visible
    writeSnapshot()
    return true
  })

  ipcMain.handle("xiaoye:set-global-shortcut", (_event, payload: unknown) => {
    if (typeof payload !== "object" || payload === null) {
      return false
    }

    const { key, value } = payload as { key?: unknown; value?: unknown }
    if (typeof key !== "string" || !GLOBAL_SHORTCUT_ACTIONS.has(key)) {
      return false
    }
    if (typeof value !== "string") {
      return false
    }

    return applyGlobalShortcut(key, value)
  })

  ipcMain.handle("xiaoye:open-external", async (_event, url: unknown) => {
    if (typeof url !== "string" || !/^https?:\/\//i.test(url) || url.length > 2048) {
      return false
    }

    await shell.openExternal(url)
    return true
  })
}

/** 退出前清理，避免残留注册影响下次启动。 */
export const teardownDesktopSettings = () => {
  globalShortcut.unregisterAll()
  registered.clear()
}
