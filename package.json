{
  "name": "zhiye",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "知叶 - 支持桌面端（Electron）与 Web 双端的 AI 知识库",
  "author": "xiaoye",
  "main": "out/main/index.js",
  "scripts": {
    "icons": "node scripts/build-icon-map.mjs",
    "dev": "node scripts/build-icon-map.mjs && electron-vite dev",
    "dev:web": "node scripts/build-icon-map.mjs && vite",
    "build": "node scripts/build-icon-map.mjs && electron-vite build",
    "build:web": "node scripts/build-icon-map.mjs && vue-tsc -b && vite build",
    "start": "electron-vite preview",
    "preview:web": "vite preview",
    "dist": "node scripts/build-icon-map.mjs && electron-vite build && electron-builder",
    "build:mac": "pnpm build && electron-builder --mac",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx && node scripts/check-style-tokens.mjs",
    "lint:fix": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "lint:style": "node scripts/check-style-tokens.mjs",
    "format": "prettier --write \"src/**/*.{js,ts,vue,css,scss}\"",
    "smoke:account": "node scripts/account-settings-smoke.mjs",
    "smoke:account:headed": "SMOKE_HEADED=1 node scripts/account-settings-smoke.mjs",
    "smoke:workspace": "node scripts/knowledge-workspace-smoke.mjs",
    "smoke:workspace:headed": "SMOKE_HEADED=1 node scripts/knowledge-workspace-smoke.mjs",
    "smoke:periphery": "node scripts/knowledge-periphery-smoke.mjs",
    "smoke:periphery:headed": "SMOKE_HEADED=1 node scripts/knowledge-periphery-smoke.mjs",
    "profile:workbench": "node scripts/knowledge-workbench-profile.mjs",
    "profile:workbench:warm": "PROFILE_MODE=warm node scripts/knowledge-workbench-profile.mjs",
    "profile:workbench:cold": "PROFILE_MODE=cold node scripts/knowledge-workbench-profile.mjs",
    "verify:codeblock": "node scripts/verify-codeblock-toolbar.mjs",
    "verify:export": "node scripts/verify-export-markdown.mjs",
    "verify:search": "node scripts/verify-editor-search.mjs",
    "verify:packaged": "node scripts/verify-packaged-app.mjs",
    "visual:capture": "node scripts/visual-capture-replica.mjs",
    "visual:report": "node scripts/visual-baseline-report.mjs",
    "visual:pixdiff": "node scripts/visual-pixdiff.mjs",
    "visual:diff": "node scripts/visual-pixdiff-dir.mjs",
    "perf:budget": "PROFILE_MODE=both node scripts/knowledge-workbench-profile.mjs && node scripts/perf-budget-check.mjs",
    "perf:budget:check": "node scripts/perf-budget-check.mjs",
    "test": "vitest run",
    "verify:settings": "node scripts/verify-desktop-settings.mjs",
    "verify:settings:native": "node scripts/verify-desktop-native.mjs",
    "audit:visual": "node scripts/audit-visual.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@excalidraw/mermaid-to-excalidraw": "^2.1.1",
    "@phosphor-icons/vue": "^2.2.1",
    "@types/turndown": "^5.0.6",
    "@vueuse/core": "^14.4.0",
    "diff": "^8.0.3",
    "dompurify": "^3.4.15",
    "element-plus": "2.14.5",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "lowlight": "^3.3.0",
    "lucide-vue-next": "^0.499.0",
    "mammoth": "^1.12.2",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.13.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "simple-mind-map": "0.14.0-fix.3",
    "swiper": "^14.2.0",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "vue": "^3.5.25",
    "vue-router": "^4.6.4",
    "yuque-editor-core": "npm:@zhangzhengyang27/yuque-editor-core@^0.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.27",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "vue-demi"
    ]
  }
}
